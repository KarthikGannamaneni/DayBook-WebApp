{
  "name": "bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=.env src/smoke.ts",
    "groups": "tsx --env-file-if-exists=.env src/groups.ts",
    "purge": "tsx --env-file-if-exists=.env src/purge.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "baileys": "6.7.24",
    "qrcode-terminal": "^0.12.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "22.8.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
