# Supabase — the bot uses the service role and therefore bypasses RLS, which is
# why every write in bot/src/pipeline.ts is scoped by an ownerId resolved from
# the group mapping. Never put this key in a NEXT_PUBLIC_* variable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini. The FREE tier may use prompts and responses to train Google's models,
# including human review — and what this product sends is the business's
# CUSTOMERS' names, UPI handles and transaction references. A paid key is a
# precondition for the first real customer. See docs/p0-tech-design.md §2.3.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp. This directory IS a credential: anyone who copies it reads every
# group the number is in.
BAILEYS_AUTH_DIR=./auth_state

# Pipeline. A single document above this many rupees is a misread decimal point
# far more often than a real transaction, so the amount is dropped and a human
# looks at it.
MAX_RUPEES=10000000

# Testing only: process messages sent by the paired account itself. Needed when
# the bot is paired to your own number, because then everything you post is
# "fromMe" and is dropped before it is logged. Leave unset in production.
INCLUDE_OWN_MESSAGES=

# Smoke test only: a group you have already linked in the web app's Settings.
SMOKE_GROUP_ID=smoke-group@g.us
