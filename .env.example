# Supabase — bot uses the service role and therefore bypasses RLS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini. The FREE tier may use prompts and responses to train Google's
# models, including human review. Do not point this at real customers' bills
# until it is a paid key. See docs/p0-tech-design.md §2.3.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bills

# Pipeline
CONFIDENCE_THRESHOLD=0.75
